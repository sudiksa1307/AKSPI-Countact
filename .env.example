# ── Countact store configuration ─────────────────────────────
# Copy to .env and fill in. Never commit .env.

PORT=4242
# Public URL of the site (used for Stripe redirect URLs). Use https:// in production.
SITE_URL=http://localhost:4242

# ── Stripe (start in TEST mode: keys begin with sk_test_) ────
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_replace_me
# From `stripe listen` output locally (whsec_...), or the endpoint's signing secret in the Dashboard.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ── Product price — the ONE place the selling price is set ───
# Smallest currency unit (cents for USD). 4000 = $40.00. Leave blank to disable checkout.
PRODUCT_PRICE_CENTS=4000
CURRENCY=usd
MAX_QUANTITY_PER_ORDER=5

# ── Shipping ─────────────────────────────────────────────────
# Flat rate per order in cents. 0 = free shipping. Leave blank to disable checkout.
SHIPPING_FLAT_RATE_CENTS=0
SHIPPING_LABEL=Standard shipping
SHIPPING_MIN_DAYS=5
SHIPPING_MAX_DAYS=8
# Comma-separated ISO country codes you ship to
SHIPPING_COUNTRIES=US

# ── Tax ──────────────────────────────────────────────────────
# automatic : Stripe Tax calculates from the shipping address (enable Stripe Tax + add registrations first)
# rate      : apply a Tax Rate you created in Stripe (set STRIPE_TAX_RATE_ID, txr_...)
# none      : collect no tax (only if that is correct for your business)
TAX_MODE=none
STRIPE_TAX_RATE_ID=
# Optional, display only, for TAX_MODE=rate (e.g. 8.25). Stripe applies the real rate.
TAX_DISPLAY_PERCENT=

# ── App demo ─────────────────────────────────────────────────
# Where the app's "Reorder contacts" button sends people (an outside lens retailer).
REORDER_CONTACTS_URL=

# Where paid orders are stored (JSON file). Defaults to ./data
# DATA_DIR=./data

# ── Amazon Multi-Channel Fulfillment (MCF) ───────────────────
# When true, every paid order's shipping details are sent to Amazon automatically
# and Amazon ships it from your FBA inventory. When false, you ship orders yourself.
MCF_ENABLED=false
# The Seller SKU of this product in Seller Central → Inventory (must have FBA stock)
MCF_SELLER_SKU=
# na = North America, eu = Europe, fe = Far East
MCF_REGION=na
# true = Amazon's sandbox (fake data, safe for testing). false = real orders.
MCF_SANDBOX=true
# Standard | Expedited | Priority  (Expedited/Priority cost you more at Amazon)
MCF_SHIPPING_SPEED=Standard
# FillOrKill (cancel if out of stock) | FillAll (wait for stock) | FillAllAvailable
MCF_FULFILLMENT_POLICY=FillOrKill
MCF_ORDER_COMMENT=Thank you for your order!
# Selling Partner API credentials (Seller Central → Develop Apps → your app)
SPAPI_LWA_CLIENT_ID=replace_me
SPAPI_LWA_CLIENT_SECRET=replace_me
SPAPI_REFRESH_TOKEN=replace_me
# How often (minutes) to retry failed submissions and check for tracking numbers
MCF_RETRY_MINUTES=5
MCF_MAX_ATTEMPTS=8
# Long random string; lets you view orders / retry stuck ones via /api/admin/orders
ADMIN_TOKEN=replace_with_long_random_string
